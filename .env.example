# .env.example (committed) # .env (NOT committed)
ASSISTANT_DATA_DIR=data
LLM_PROVIDER=stub
LLM_API_KEY=
CREDIT_RATE_VND=450000
RETAKE_MULTIPLIER=1.5
MAX_CREDITS=30
LOG_LEVEL=INFO

# Lab 4 API
API_ADMIN_KEY=change-me
RATE_LIMIT_PER_MIN=30
WEATHER_URL=https://api.open-meteo.com/v1/forecast
CAMPUS_LAT=10.7626
CAMPUS_LON=106.6822
WEATHER_TIMEOUT_S=3.0

# Lab 5 persistence
# Persistent SQLite file (created on first start; ignored by Git).
DATABASE_URL=sqlite:///assistant.db
# Secret salt for hashing session ids. Required by the API. Use a long random value in .env, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SALT=
